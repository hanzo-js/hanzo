{
  "name": "hanzo",
  "version": "8.5.157",
  "description": "Hanzo \u2014 the CLI and the client, in one install.",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanzo-js/hanzo.git"
  },
  "homepage": "https://hanzo.ai",
  "bin": {
    "hanzo": "bin/hanzo.js"
  },
  "type": "module",
  "types": "./cloud.d.ts",
  "exports": {
    ".": {
      "types": "./cloud.d.ts",
      "import": "./cloud.mjs",
      "require": "./cloud.cjs"
    },
    "./ai": {
      "types": "./ai.d.ts",
      "import": "./ai.mjs",
      "require": "./ai.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "cloud.mjs",
    "cloud.cjs",
    "cloud.d.ts",
    "ai.mjs",
    "ai.cjs",
    "ai.d.ts",
    "README.md"
  ],
  "dependencies": {
    "@hanzo/cli": "^8.5.156",
    "@hanzo/ai": "^0.6.16",
    "hanzoai": "^8.5.157"
  },
  "engines": {
    "node": ">=18"
  }
}
